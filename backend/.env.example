# ChargeSpot API settings. Copy this file to .env and fill in real values.
# Never commit .env. The API refuses to start if a REQUIRED value is missing.

# REQUIRED. The main database: the Supabase "Session pooler" connection string, with
# "postgresql://" changed to "postgresql+psycopg://" and [YOUR-PASSWORD] (brackets
# included) replaced by the database password. URL-encode @ : / # % ? in the password.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# REQUIRED. Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional. Token algorithm and lifetime (defaults: HS256, 1440 minutes = 1 day).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# REQUIRED. OAuth client ID from Google Cloud Console (must match the web app's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Optional. Only needed for the Google *redirect* sign-in flow (the "Continue with Google" fallback).
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# REQUIRED. Where the user web app runs. Google sign-in redirects back here.
FRONTEND_URL=http://localhost:5173

# Optional. Comma-separated origins allowed to call the API from a browser.
# Defaults to FRONTEND_URL. Add the kiosk app's URL here from Phase 6.
CORS_ORIGINS=http://localhost:5173

# ---- Database tooling (database/ folder). Not used by the running API. ----

# For automated tests: a throwaway LOCAL PostgreSQL database that the tests wipe on
# every run. Create it once (CREATE DATABASE chargespot_test). Never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/chargespot_test

# Open Charge Map API key (free: openchargemap.org -> My Profile -> API keys).
OCM_API_KEY=

# Optional. Which state to import stations for (default: gujarat).
IMPORT_REGION=gujarat

# Optional. Old local database, read once by database/imports/migrate_users.py.
LEGACY_DATABASE_URL=

# Optional. Password for the demo accounts (a random one is generated and shown once if unset).
DEMO_PASSWORD=
