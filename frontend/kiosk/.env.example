# ChargeSpot station kiosk settings. Copy this file to .env and fill in real values.
# Vite exposes every VITE_* value to the browser, so never put secrets here.
# The kiosk's own key is NOT set here: it is pasted once on the tablet's setup screen.

# REQUIRED. Where the ChargeSpot API runs.
VITE_API_URL=http://localhost:8000
