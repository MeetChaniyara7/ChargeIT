# ChargeSpot web app settings. Copy this file to .env and fill in real values.
# Vite exposes every VITE_* value to the browser, so never put secrets here.

# REQUIRED. Where the ChargeSpot API runs.
VITE_API_URL=http://localhost:8000

# REQUIRED. Google OAuth client ID. Must be the same as the API's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Supabase project URL and public anon key. Used from Phase 5 for live updates only.
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
